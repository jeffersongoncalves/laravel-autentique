{
    "name": "jeffersongoncalves/laravel-autentique",
    "description": "Laravel client for the Autentique GraphQL API (e-signature): documents, signers, folders, sandbox, rate-limit aware requests and signed webhooks.",
    "keywords": [
        "laravel",
        "autentique",
        "e-signature",
        "assinatura-digital",
        "graphql",
        "webhooks"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-autentique",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "laravel/framework": "^12.61.1|^13.12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "jeffersongoncalves/pest-plugin-database-migrations": "^1.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7.4|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\Autentique\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\Autentique\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\Autentique\\AutentiqueServiceProvider"
            ],
            "aliases": {
                "Autentique": "JeffersonGoncalves\\Autentique\\Facades\\Autentique"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
